{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!dist", "!.wrangler", "!.budget", "!node_modules", "!services/doc/data"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.md"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "hono": "src/core must not import hono. Take what you need through the core context (ADR 0013).",
                  "hono/jsx": "src/core must not import hono. Take what you need through the core context (ADR 0013)."
                },
                "patterns": [
                  {
                    "group": ["**/web/**", "**/web"],
                    "message": "src/core must not import src/web. Product actions stay independent of the web layer (ADR 0013)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
